# Copy to .env.local and replace placeholders. These are PUBLIC browser values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key
# Alternatively use VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Never use sb_secret_... or a service_role JWT in any VITE_ variable.

# Keep local until the projects migration/import and RLS/storage checks are verified.
VITE_PROJECTS_SOURCE=local
# Set to supabase to activate database-only published portfolio data.

# Staging inquiry workflow only. Off until migration/function/CAPTCHA are configured.
VITE_INQUIRIES_ENABLED=false
VITE_TURNSTILE_SITE_KEY=your-staging-turnstile-public-site-key
# Server secrets (INQUIRY_TURNSTILE_SECRET, INQUIRY_HMAC_SECRET) NEVER belong in VITE_.

VITE_SERVICES_SOURCE=local
VITE_SERVICE_INQUIRIES_ENABLED=false
